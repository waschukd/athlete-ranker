node_modules/
.next/
.env
.env.local
.env*.local
*.log
.claude/
ios/
# Ignore the generated/build contents of android/ but keep the manifest
# tracked. Git can't re-include a file whose parent dir is fully ignored,
# so we un-ignore each parent step before re-ignoring the noisy children.
android/*
!android/app/
android/app/*
!android/app/src/
!android/app/build.gradle
android/app/src/*
!android/app/src/main/
android/app/src/main/*
!android/app/src/main/AndroidManifest.xml
.vercel
test-data/
# Catch-all for env files the earlier rules miss -- .env.production.local from
# `vercel env pull` holds real production secrets. Templates stay tracked.
.env*
!.env*.example

# Recovery dump from scripts/repair-phantom-rank-drills.mjs — real athlete data
phantom-rank-backup.json

# Roster dumps from scripts/clear-category-athletes.mjs -- real athlete data
roster-backup-cat*.json
